[Unit]
Description=Периодическая смена обоев и палитры (ASWaDPFTLS)

[Timer]
# Через минуту после старта графической сессии, далее каждые 30 минут.
# Программа сама выбирает папку по времени суток, поэтому регулярный запуск
# поддерживает палитру в соответствии со временем дня.
OnStartupSec=1min
OnUnitActiveSec=30min
Persistent=true

[Install]
WantedBy=timers.target
